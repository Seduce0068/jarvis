// OpenCode V2 configuration for the jarvis user.
// Deployed to /home/jarvis/.config/opencode/opencode.jsonc.
//
// The JARVIS gateway is exposed over MCP Streamable HTTP on localhost;
// tool calls are policy-checked and allowlist-gated by jarvis-mcp-gw.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jarvis-gateway": {
        "type": "remote",
        "url": "http://127.0.0.1:8082/mcp",
        "oauth": false
      }
    }
  }
}
