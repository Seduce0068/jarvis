# Bitwarden Secrets Manager access token for the jarvis machine account.
# Copy to /etc/jarvis/bws.env on the host and chmod 600.
BWS_ACCESS_TOKEN=0.xxxx.yyyy:zzzz

# Bitwarden Secrets Manager project ID. All jarvis-* systemd units read this
# single value via EnvironmentFile= and pass it to `bws run --project-id`.
# Replace the placeholder with the project ID of the target deployment.
JARVIS_BWS_PROJECT_ID=<project-id>
