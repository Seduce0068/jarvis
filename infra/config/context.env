# JARVIS Context Builder Environment Variables
# NOTE: Legacy reference template. Current systemd units do not use this file directly.
# Runtime secret/config injection differs by service (verify installed units and /etc/jarvis state).
# Values may be outdated (e.g. op:// references, paths).

JARVIS_CONTEXT_GRPC_ADDR=127.0.0.1:50054
JARVIS_CONTEXT_HTTP_ADDR=127.0.0.1:8084
JARVIS_CONTEXT_PG_URL=op://JARVIS/PostgreSQL/connection_string
JARVIS_CONTEXT_QDRANT_URL=http://127.0.0.1:6334
JARVIS_CONTEXT_QDRANT_API_KEY=
JARVIS_CONTEXT_COLLECTION_NAME=jarvis_memories
JARVIS_CONTEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector size of the Qdrant collection. Must match the embedding model's output
# dimension (384 for sentence-transformers/all-MiniLM-L6-v2). Legacy configs
# without the key default to 384 to avoid a zero-sized collection.
# JARVIS_CONTEXT_EMBEDDING_DIM=<dimension>
# Embedding endpoint (Ollama-compatible POST /api/embed). Empty = vector search disabled.
JARVIS_CONTEXT_EMBEDDING_URL=
JARVIS_CONTEXT_PII_PATTERNS_PATH=/etc/jarvis/pii_patterns.toml
JARVIS_CONTEXT_MAX_CONTEXT_TOKENS=8000
# Admin token for the memory/context HTTP API. When set, API routes require
# x-jarvis-context-token (health and the Prometheus scrape route are exempt).
# Unset keeps legacy loopback behavior.
# Set at deployment; never commit a value.
# JARVIS_CONTEXT_ADMIN_TOKEN=<set-at-deployment>

# Config file path override. Overrides the default /etc/jarvis/context.toml.
# Read directly via std::env::var (excluded from the Figment field provider).
# JARVIS_CONTEXT_CONFIG_PATH=<path-to-context.toml>
