# JARVIS MCP Gateway Environment Variables
# Populated by 1Password CLI at runtime

JARVIS_MCP_GW_GRPC_ADDR=127.0.0.1:50052
JARVIS_MCP_GW_HTTP_ADDR=127.0.0.1:8082
JARVIS_MCP_GW_ALLOWLIST_PATH=/etc/jarvis/mcp_allowlist.toml
JARVIS_MCP_GW_SANDBOX_TYPE=firejail
JARVIS_MCP_GW_SANDBOX_CONFIG={}
JARVIS_MCP_GW_POLICY_GRPC_ADDR=http://127.0.0.1:50051

# Docker image for sandboxed execution
JARVIS_MCP_GW_DOCKER_IMAGE=jarvis-mcp-runner:latest