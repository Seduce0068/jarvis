# JARVIS MCP Gateway Environment Variables
# Repo template and single deployment source for the host override file
# /etc/jarvis/jarvis-mcp-gw.env (I50-A). jarvis-mcp-gw.service reads that path
# via EnvironmentFile=-/etc/jarvis/jarvis-mcp-gw.env; values read from an
# EnvironmentFile take precedence over the unit's literal Environment= defaults.
# Keep this repo filename; deploy-mcp-gw-safe.sh installs it atomically to the
# /etc path (root:root, 0600, with a .bak-$ts backup).
# Secrets are supplied by Bitwarden Secrets Manager via /etc/jarvis/bws.env
# (bws run). This template contains NO op:// references: only commented
# <set-at-deployment> placeholders are present. Do not paste real secrets
# into this template.

JARVIS_MCP_GW_GRPC_ADDR=127.0.0.1:50052
JARVIS_MCP_GW_HTTP_ADDR=127.0.0.1:8082
JARVIS_MCP_GW_ALLOWLIST_PATH=/etc/jarvis/mcp_allowlist.toml
# Workspace root for the native read-only handlers (filesystem.*, git.*) and
# the path-escape boundary. Host-specific: keep it readable under
# ProtectHome=read-only and containing the workspace exercised by the runtime
# E2E check. The unit's Environment= value is only a literal default; this key
# is the supported override and is mandatory in the deployed env file.
JARVIS_MCP_GW_BASE_DIR=/home/koppe/ドキュメント/作業用/jarvis/jarvis
# Upstream MCP servers registered at startup. TOML uses [[upstreams]] blocks;
# the env form is a TOML-style array of tables
# (e.g. [{name="fs",command=["/usr/bin/mcp-fs"]}]). No value is stored here.
# JARVIS_MCP_GW_UPSTREAMS=<upstream-definitions>
# Legacy compatibility keys only: parsed but NOT used by the execution path
# (ADR-0002). The code default is "none"; any non-default value merely emits a
# startup warning and enforces no sandbox boundary.
JARVIS_MCP_GW_SANDBOX_TYPE=none
JARVIS_MCP_GW_SANDBOX_CONFIG={}
JARVIS_MCP_GW_POLICY_GRPC_ADDR=http://127.0.0.1:50051
# HTTP base URL of jarvis-policy for the human approval flow (MCP-1)
JARVIS_MCP_GW_POLICY_HTTP_ADDR=http://127.0.0.1:8081
# Principal attributed to MCP clients connected to /mcp (must be in the
# allowlist's principals list)
JARVIS_MCP_GW_MCP_PRINCIPAL=opencode
# Opt-in strict guard: when enabled, tool calls ignore the wire-level
# principal field and use JARVIS_MCP_GW_MCP_PRINCIPAL for every policy,
# allowlist, approval and log decision. Default keeps the legacy behavior.
# JARVIS_MCP_GW_REQUIRE_SERVER_SIDE_PRINCIPAL

# Optional: token sent as X-Jarvis-Approval-Token to jarvis-policy.
# JARVIS_MCP_GW_APPROVAL_API_TOKEN=<set-at-deployment>

# Shared token for the gRPC listener. When set, every RPC must send the
# x-jarvis-grpc-token metadata header. RegisterMcpServer (admin RPC) stays
# fail-closed when this is unset; other RPCs keep legacy loopback behavior.
# JARVIS_MCP_GW_ADMIN_TOKEN=<set-at-deployment>

# Comma-separated host allowlist for outbound web.fetch (exact match or "*."
# suffix). Blank or malformed values normalize to deny-all (fail-closed); there
# is NO "unset means unrestricted" fallback. This env var overrides the TOML
# egress_allowlist key.
#
# Three layers decide the effective value (highest priority last):
#   1. Code default: an empty string, so a bare process with no env var denies
#      every fetch (deny-all).
#   2. systemd unit literal default: jarvis-mcp-gw.service sets
#      Environment=JARVIS_MCP_GW_EGRESS_ALLOWLIST=example.com as a LITERAL —
#      systemd.exec(5) performs no ${...} expansion in Environment=, so on the
#      real unit with no host override ONLY example.com is allowed; that is not
#      deny-all, despite the empty code default.
#   3. Host override (highest): /etc/jarvis/jarvis-mcp-gw.env, read by the
#      unit's EnvironmentFile=-/etc/jarvis/jarvis-mcp-gw.env, is the ONLY
#      supported override path and its values take precedence over
#      Environment=. Set JARVIS_MCP_GW_EGRESS_ALLOWLIST there to the minimum
#      host set (or to an empty string for a genuine deny-all deployment).
# Deployed value: empty = genuine deny-all (fail-closed), overriding the unit's
# example.com literal. Only add a minimal comma-separated host set if web.fetch
# egress is actually required. This key is mandatory in the deployed env file.
JARVIS_MCP_GW_EGRESS_ALLOWLIST=

# Human approval window in seconds. Drives both expires_at and the HTTP
# deadline; must match jarvis-policy's approval_timeout_secs (default 300).
# JARVIS_MCP_GW_APPROVAL_WINDOW_SECS=<set-at-deployment>

# Config file path override. Overrides the default /etc/jarvis/mcp_gateway.toml.
# Read directly via std::env::var (excluded from the Figment field provider).
# JARVIS_MCP_GW_CONFIG_PATH=<path-to-mcp_gateway.toml>
