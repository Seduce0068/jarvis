# JARVIS MCP Gateway Environment Variables
# NOTE: Legacy reference template. Current systemd units do not use this file.
# Secrets are supplied by Bitwarden Secrets Manager via /etc/jarvis/bws.env
# (bws run); values below are for reference only, do not paste real secrets.

JARVIS_MCP_GW_GRPC_ADDR=127.0.0.1:50052
JARVIS_MCP_GW_HTTP_ADDR=127.0.0.1:8082
JARVIS_MCP_GW_ALLOWLIST_PATH=/etc/jarvis/mcp_allowlist.toml
JARVIS_MCP_GW_SANDBOX_TYPE=firejail
JARVIS_MCP_GW_SANDBOX_CONFIG={}
JARVIS_MCP_GW_POLICY_GRPC_ADDR=http://127.0.0.1:50051
# HTTP base URL of jarvis-policy for the human approval flow (MCP-1)
JARVIS_MCP_GW_POLICY_HTTP_ADDR=http://127.0.0.1:8081
# Principal attributed to MCP clients connected to /mcp (must be in the
# allowlist's principals list)
JARVIS_MCP_GW_MCP_PRINCIPAL=opencode
# Opt-in strict guard: when enabled, tool calls ignore the wire-level
# principal field and use JARVIS_MCP_GW_MCP_PRINCIPAL for every policy,
# allowlist, approval and log decision. Default keeps the legacy behavior.
# JARVIS_MCP_GW_REQUIRE_SERVER_SIDE_PRINCIPAL

# Optional: token sent as X-Jarvis-Approval-Token to jarvis-policy.
# JARVIS_MCP_GW_APPROVAL_API_TOKEN=<set-at-deployment>
