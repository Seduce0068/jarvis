// JARVIS Cedar schema (informational).
//
// Documents the intended entity model for future policy validation.
// This file is NOT parsed at runtime yet; enforcement comes from
// policies.cedar (+ optional entities.json) in this directory.
//
// TODO: align the schema with the request context actually passed by the
// services (actions need `context` declarations, and the approval workflow
// needs a concrete ApprovalRequest entity) before enabling schema validation.

namespace jarvis;

entity Principal {
    uid: String,
    role: String,  // "admin", "user", "agent", "system"
    capabilities: Set<String>
}

entity Resource {
    uid: String,
    type: String,  // "tool", "service", "data", "device"
    owner: String,
    sensitivity: String,  // "public", "private", "confidential", "restricted"
    tags: Set<String>
}

entity Action {
    uid: String,
    name: String,  // "read", "write", "execute", "delete", "approve"
    risk_level: String,  // "low", "medium", "high", "critical"
    requires_approval: Boolean
}

entity Context {
    correlation_id: String,
    timestamp: String,
    source: String,  // "ha", "android", "email", "calendar", "web", "manual"
    event_type: String,
    auto_respond: Boolean
}

// Actions
action "read" appliesTo (Principal, Resource);
action "write" appliesTo (Principal, Resource);
action "execute" appliesTo (Principal, Resource);
action "delete" appliesTo (Principal, Resource);
action "approve" appliesTo (Principal, Resource);
