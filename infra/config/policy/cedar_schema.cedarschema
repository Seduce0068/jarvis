// JARVIS Cedar schema.
//
// Documents the entity model and request shapes used by the services.
// This file IS parsed at startup: `CedarEngine::new` loads it from the policy
// directory and type-checks the shipped policies with `Validator::new(schema)`
// in `ValidationMode::Strict` (the same gate applies to policies added later).
// A validation error is fatal, so startup fails closed. Enforcement itself
// comes from policies.cedar (+ optional entities.json) in this directory.
//
// 2026-11-20: aligned with the requests actually built at runtime:
// - principals/actions/resources are bare string UIDs with no required
//   attributes (the richer ABAC attributes below are optional placeholders),
// - the context is not a caller-supplied, untyped tool-argument object.
//   `jarvis-mcp-gw::policy_context` passes exactly four server-controlled,
//   allowlist-derived attributes: `tool`, `principal`, `resource` and
//   `requires_approval`. A caller cannot forge ABAC fields through tool
//   arguments; the shipped policies condition only on principal/action/
//   resource.
//
// 2026-11-23: those four attributes are now DECLARED AS REQUIRED on every
// action below, and `CedarEngine::is_authorized` type-checks the runtime
// context against this schema. A context with a missing or misspelled
// attribute, an extra caller-supplied field, a wrong type, or an undeclared
// action is rejected (fail-closed deny). This is an intentional compatibility
// change: callers that previously sent `{}` or arbitrary context keys must
// now send the four fields above. The startup/management policy type-check
// described at the top of this file is unchanged by this declaration.

namespace jarvis {

// Runtime requests reference principals/resources by UID only
// (e.g. jarvis::Principal::"jarvis_admin"). Attributes are optional so an
// empty entities.json still validates under the strict startup validation.
entity Principal {
    uid?: String,
    role?: String,  // "admin", "user", "agent", "system"
    capabilities?: Set<String>
};

entity Resource {
    uid?: String,
    type?: String,  // "tool", "service", "data", "device"
    owner?: String,
    sensitivity?: String,  // "public", "private", "confidential", "restricted"
    tags?: Set<String>
};

// Concrete record for the approval workflow (mirrors
// `jarvis_policy::policy::ApprovalRequest`). `context` (arbitrary JSON) is
// intentionally excluded: Cedar schemas cannot express open JSON payloads.
entity ApprovalRequest {
    id: String,
    principal: String,
    action: String,
    resource: String,
    requested_at: String,  // RFC 3339
    expires_at: String  // RFC 3339
};

// Actions served by the policy engine. Their `context` is the fixed,
// server-controlled four-field record built by `jarvis-mcp-gw::policy_context`
// (see the header comment), never the caller's raw tool arguments. Every
// attribute is required (no `?`), so a nonconforming context fails closed.
action "read" appliesTo {
    principal: Principal,
    resource: Resource,
    context: {
        "tool": String,
        "principal": String,
        "resource": String,
        "requires_approval": Bool
    }
};
action "write" appliesTo {
    principal: Principal,
    resource: Resource,
    context: {
        "tool": String,
        "principal": String,
        "resource": String,
        "requires_approval": Bool
    }
};
action "execute" appliesTo {
    principal: Principal,
    resource: Resource,
    context: {
        "tool": String,
        "principal": String,
        "resource": String,
        "requires_approval": Bool
    }
};
action "delete" appliesTo {
    principal: Principal,
    resource: Resource,
    context: {
        "tool": String,
        "principal": String,
        "resource": String,
        "requires_approval": Bool
    }
};
action "approve" appliesTo {
    principal: Principal,
    resource: Resource,
    context: {
        "tool": String,
        "principal": String,
        "resource": String,
        "requires_approval": Bool
    }
};
}
