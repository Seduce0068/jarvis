// JARVIS Cedar schema.
//
// Documents the entity model and request shapes used by the services.
// This file is still NOT parsed for enforcement at runtime; enforcement
// comes from policies.cedar (+ optional entities.json) in this directory.
// Tests in `rust/jarvis-policy/src/policy.rs` verify that this schema parses
// and that the shipped `policies.cedar` validates against it.
//
// 2026-11-15: aligned with the requests actually built by
// `CedarEngine::is_authorized`:
// - principals/actions/resources are bare string UIDs with no required
//   attributes (the richer ABAC attributes below are optional placeholders),
// - actions declare no context attributes yet: the gateway passes tool
//   arguments as an untyped context object, which cannot be expressed as a
//   closed record. Enabling schema validation at runtime therefore requires
//   a typed context contract per tool (or open-record support) first.

namespace jarvis {

// Runtime requests reference principals/resources by UID only
// (e.g. jarvis::Principal::"jarvis_admin"). Attributes are optional so an
// empty entities.json still validates once schema validation is enabled.
entity Principal {
    uid?: String,
    role?: String,  // "admin", "user", "agent", "system"
    capabilities?: Set<String>
};

entity Resource {
    uid?: String,
    type?: String,  // "tool", "service", "data", "device"
    owner?: String,
    sensitivity?: String,  // "public", "private", "confidential", "restricted"
    tags?: Set<String>
};

// Concrete record for the approval workflow (mirrors
// `jarvis_policy::policy::ApprovalRequest`). `context` (arbitrary JSON) is
// intentionally excluded: Cedar schemas cannot express open JSON payloads.
entity ApprovalRequest {
    id: String,
    principal: String,
    action: String,
    resource: String,
    requested_at: String,  // RFC 3339
    expires_at: String  // RFC 3339
};

// Actions served by the policy engine. Context is intentionally undeclared
// (defaults to an empty record) until a typed per-tool context contract
// exists; see the header comment.
action "read" appliesTo {
    principal: Principal,
    resource: Resource
};
action "write" appliesTo {
    principal: Principal,
    resource: Resource
};
action "execute" appliesTo {
    principal: Principal,
    resource: Resource
};
action "delete" appliesTo {
    principal: Principal,
    resource: Resource
};
action "approve" appliesTo {
    principal: Principal,
    resource: Resource
};
}
