# code-server Environment Variables
# Populated by 1Password CLI at runtime

PASSWORD_FILE=/etc/jarvis/code-server-password
SHELL=/bin/bash

# Extensions to install on first run
CODE_SERVER_EXTENSIONS=rust-lang.rust-analyzer,dbaeumer.vscode-eslint,ms-python.python,ms-vscode-remote.remote-containers,github.vscode-github-actions,hashicorp.terraform,redhat.vscode-yaml