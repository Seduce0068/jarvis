# JARVIS Event Normalizer Environment Variables
# NOTE: Legacy reference template. Current systemd units do not use this file directly.
# Runtime secret/config injection differs by service (verify installed units and /etc/jarvis state).
# Values may be outdated (e.g. op:// references, paths).
#
# Gmail/Calendar events arrive through the webhook endpoints
# (/webhook/gmail, /webhook/calendar); OAuth polling is not implemented, so
# no client credentials are configured here.

JARVIS_EVENT_GRPC_ADDR=127.0.0.1:50053
JARVIS_EVENT_HTTP_ADDR=127.0.0.1:8083
JARVIS_EVENT_WEBHOOK_ADDR=127.0.0.1:8085
JARVIS_EVENT_HA_URL=http://homeassistant.local:8123
JARVIS_EVENT_HA_TOKEN=op://JARVIS/Home Assistant/long_lived_token
JARVIS_EVENT_ANDROID_MCP_URL=http://127.0.0.1:49374
JARVIS_EVENT_OPENCODE_URL=http://127.0.0.1:49374
JARVIS_EVENT_OPENCODE_LOCATION=/home/jarvis/repos
JARVIS_EVENT_POLICY_GRPC_ADDR=http://127.0.0.1:50051
# Context backend selection: in_process (default) or grpc. In grpc mode the
# context sidecar builds the context so source/timestamp fields survive the hop.
# JARVIS_EVENT_CONTEXT_MODE=<in_process|grpc>
# gRPC endpoint of the context sidecar; only read when context mode is grpc.
# JARVIS_EVENT_CONTEXT_GRPC_ADDR=<host:port>
# Optional x-jarvis-context-token for BuildContext calls. Blank/unset keeps
# the legacy unauthenticated loopback path. Set at deployment; never commit.
# JARVIS_EVENT_CONTEXT_GRPC_TOKEN=<set-at-deployment>
# Admin token for the event emit API (/v1/events and gRPC EmitEvent). When set,
# callers must present x-jarvis-event-token (HTTP) / metadata (gRPC);
# health/metrics are exempt. Unset keeps legacy loopback behavior.
# Set at deployment; never commit a value.
# JARVIS_EVENT_ADMIN_TOKEN=<set-at-deployment>
