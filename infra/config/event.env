# JARVIS Event Normalizer Environment Variables
# Populated by 1Password CLI at runtime

JARVIS_EVENT_GRPC_ADDR=127.0.0.1:50053
JARVIS_EVENT_HTTP_ADDR=127.0.0.1:8083
JARVIS_EVENT_WEBHOOK_ADDR=127.0.0.1:8085
JARVIS_EVENT_HA_URL=http://homeassistant.local:8123
JARVIS_EVENT_HA_TOKEN=op://JARVIS/Home Assistant/long_lived_token
JARVIS_EVENT_ANDROID_MCP_URL=http://127.0.0.1:49374
JARVIS_EVENT_OPENCODE_URL=http://127.0.0.1:49374
JARVIS_EVENT_OPENCODE_LOCATION=/home/jarvis/repos
JARVIS_EVENT_POLICY_GRPC_ADDR=http://127.0.0.1:50051
JARVIS_EVENT_CONTEXT_GRPC_ADDR=http://127.0.0.1:50054

# External API keys
JARVIS_EVENT_GMAIL_CLIENT_ID=op://JARVIS/Gmail/client_id
JARVIS_EVENT_GMAIL_CLIENT_SECRET=op://JARVIS/Gmail/client_secret
JARVIS_EVENT_CALENDAR_CLIENT_ID=op://JARVIS/Google Calendar/client_id
JARVIS_EVENT_CALENDAR_CLIENT_SECRET=op://JARVIS/Google Calendar/client_secret