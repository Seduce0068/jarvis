# JARVIS Policy Engine Environment Variables
# NOTE: Legacy reference template. Current systemd units do not use this file directly.
# Runtime secret/config injection differs by service (verify installed units and /etc/jarvis state).
# Values may be outdated (e.g. op:// references, paths).

# Service configuration
JARVIS_POLICY_GRPC_ADDR=127.0.0.1:50051
JARVIS_POLICY_HTTP_ADDR=127.0.0.1:8081
JARVIS_POLICY_CEDAR_POLICY_DIR=/etc/jarvis/policy
JARVIS_POLICY_CASBIN_MODEL_PATH=/etc/jarvis/policy/casbin_model.conf
JARVIS_POLICY_CASBIN_POLICY_PATH=/etc/jarvis/policy/casbin_policy.csv
# Config file path override. Overrides the default /etc/jarvis/policy.toml.
# Read directly via std::env::var (excluded from the Figment field provider).
# JARVIS_POLICY_CONFIG_PATH=<path-to-policy.toml>
JARVIS_POLICY_KILL_SWITCH_ADMIN_TOKEN=op://JARVIS/Policy/admin_token
# Persist the kill switch so a policy restart cannot silently disarm it.
JARVIS_POLICY_KILL_SWITCH_STATE_PATH=/var/lib/jarvis/kill-switch.json
JARVIS_POLICY_APPROVAL_TIMEOUT_SECS=300
# Upper bound on simultaneously pending approval requests (default 100)
JARVIS_POLICY_APPROVAL_MAX_PENDING=100
# Legacy compatibility key: the placeholder admin token is now rejected
# unconditionally at startup, so this flag no longer changes behavior.
# A real token must be injected by the secret manager before service start.
# JARVIS_POLICY_REQUIRE_KILL_SWITCH_ADMIN_TOKEN
# Opt-in strict startup guard: fail closed when kill_switch_state_path is
# unset/blank, so an emergency stop cannot silently lose its durable state.
# Default keeps the legacy warn-only behavior.
# JARVIS_POLICY_REQUIRE_KILL_SWITCH_STATE_PATH
# Opt-in strict startup guard: fail closed when pg_url is unset/blank while
# approval persistence is required. Default keeps the legacy behavior.
# JARVIS_POLICY_REQUIRE_APPROVAL_PERSISTENCE
# Optional: require X-Jarvis-Approval-Token on the approval endpoints.
# Scope split (mirrors config.rs / http.rs):
#   API scope (request/list/status) -> JARVIS_POLICY_APPROVAL_API_TOKEN
#   Admin scope (approve/deny)      -> JARVIS_POLICY_APPROVAL_ADMIN_TOKEN
# If the admin token is unset, approve/deny fall back to the API token, so a
# caller holding the API token can approve its own request (no separation of
# duties). The MCP gateway sends the API token; the approval UI sends the API
# token for list and the admin token for decisions. The legacy UI alias
# JARVIS_POLICY_APPROVAL_TOKEN is accepted temporarily with a deprecation warning.
# JARVIS_POLICY_APPROVAL_API_TOKEN=<set-at-deployment>
# JARVIS_POLICY_APPROVAL_ADMIN_TOKEN=<set-at-deployment>
# Opt-in strict guard: when enabled, approval endpoints return 503 (fail
# closed) while no approval token is configured. Default keeps the legacy
# loopback-only behavior; enable only after the token is provisioned.
# JARVIS_POLICY_REQUIRE_APPROVAL_API_TOKEN
# Kept for compatibility; authorization is always deny-by-default regardless.
JARVIS_POLICY_DEFAULT_DENY=true

# Database (PostgreSQL for audit log)
JARVIS_POLICY_PG_URL=op://JARVIS/PostgreSQL/connection_string
