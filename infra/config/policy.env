# JARVIS Policy Engine Environment Variables
# Populated by 1Password CLI at runtime

# OCI Configuration
JARVIS_POLICY_GRPC_ADDR=127.0.0.1:50051
JARVIS_POLICY_HTTP_ADDR=127.0.0.1:8081
JARVIS_POLICY_CEDAR_POLICY_DIR=/etc/jarvis/policy
JARVIS_POLICY_CASBIN_MODEL_PATH=/etc/jarvis/casbin_model.conf
JARVIS_POLICY_CASBIN_POLICY_PATH=/etc/jarvis/casbin_policy.csv
JARVIS_POLICY_KILL_SWITCH_ADMIN_TOKEN=op://JARVIS/Policy/admin_token
JARVIS_POLICY_APPROVAL_TIMEOUT_SECS=300
JARVIS_POLICY_DEFAULT_DENY=true

# Database (PostgreSQL for audit log)
JARVIS_POLICY_PG_URL=op://JARVIS/PostgreSQL/connection_string