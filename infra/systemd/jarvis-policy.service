[Unit]
Description=JARVIS Policy Engine
Documentation=https://github.com/Seduce0068/jarvis
After=network.target postgresql.service qdrant.service jarvis-migrations.service
Wants=postgresql.service qdrant.service jarvis-migrations.service
# Shared migrations (001 and later, currently through 005) are pre-applied by
# jarvis-migrations.service (oneshot), ordered above; the final applier is
# jarvis-context.service, which embeds the same migrations in its binary via
# `sqlx::migrate!()`. Do NOT add After=/Wants=jarvis-context.service:
# jarvis-context already declares After=jarvis-policy.service, so doing so
# would create an ordering cycle in systemd-analyze verify.

[Service]
Type=exec
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env

# Secrets are resolved by bws run (Bitwarden Secrets Manager) at service start
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /opt/jarvis/bin/jarvis-policy
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# I54-D: immediate stop — the engine does not drain in-flight handlers;
# an in-flight ApprovalStore::decide commit is NOT guaranteed to finish.
# 10s is only a bounded teardown budget for bws signal forwarding and
# tracer flush, NOT a graceful-drain window; reaching it means SIGKILL.
# The binary's shutdown log uses shutdown_policy=immediate-stop to match.
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis /var/lib/jarvis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=HOME=/opt/jarvis/data
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-policy

[Install]
WantedBy=multi-user.target
