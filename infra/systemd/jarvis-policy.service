[Unit]
Description=JARVIS Policy Engine
Documentation=https://github.com/Seduce0068/jarvis
After=network.target postgresql.service qdrant.service
Wants=postgresql.service qdrant.service
# NOTE: shared migrations (001-003) are applied by jarvis-context at startup.
# Do NOT add After=/Wants=jarvis-context.service here: that unit already
# depends on this one, and systemd would report an ordering cycle. On a fresh
# DB, start jarvis-context once (or run `cargo sqlx migrate run`) before
# enabling approval persistence here.

[Service]
Type=exec
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env

# 1Password references in policy.env are resolved at service start
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /opt/jarvis/bin/jarvis-policy
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis /var/lib/jarvis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=HOME=/opt/jarvis/data
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-policy

[Install]
WantedBy=multi-user.target
