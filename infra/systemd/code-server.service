[Unit]
Description=code-server (Browser IDE)
Documentation=https://coder.com/docs/code-server
After=network.target
Wants=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/home/jarvis/repos
ExecStart=/usr/bin/code-server --bind-addr 127.0.0.1:8080 --auth password
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/jarvis/repos /home/jarvis/.config/code-server /home/jarvis/.local/share/code-server /tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
UMask=0077
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# Environment
# PASSWORD_FILE は code-server の config.yaml（~/.config/code-server/config.yaml, 0600）へ集約する方針。
# build-selfhost.sh が生成 unit から Environment=PASSWORD_FILE= 行を sed で削除するため、テンプレートでも宣言しない。
Environment=SHELL=/bin/bash

# Resource limits
LimitNOFILE=65536
MemoryMax=4G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=code-server

[Install]
WantedBy=multi-user.target
