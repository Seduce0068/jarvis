[Unit]
Description=OpenTelemetry Collector for JARVIS
Documentation=https://opentelemetry.io/docs/collector/
After=network.target
Wants=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis
# journald receiver reads /var/log/journal (root:systemd-journal 0640).
# Without this supplementary group the logs pipeline receives nothing.
SupplementaryGroups=systemd-journal

# SEC-1 (2026-11-15): aligned with the installed (working) unit.
# The installed service runs otelcol-contrib directly against
# /etc/jarvis/otelcol-config.yaml and does not use op run / bws.
# The credential supply path for Grafana Cloud is not yet identified
# (otel.env / op.env are absent on the host); do not reintroduce
# op run here without confirming the secret source.
ExecStart=/usr/local/bin/otelcol-contrib --config /etc/jarvis/otelcol-config.yaml
UMask=0077
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/jarvis /var/log/jarvis

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=otelcol

[Install]
WantedBy=multi-user.target
