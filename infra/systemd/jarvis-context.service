[Unit]
Description=JARVIS Context Builder
Documentation=https://github.com/koppe/jarvis
After=network.target postgresql.service qdrant.service jarvis-policy.service
Wants=postgresql.service qdrant.service jarvis-policy.service

[Service]
Type=notify
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
ExecStartPre=/usr/local/bin/op inject -i /etc/jarvis/context.env -o /run/jarvis/context.env
ExecStart=/opt/jarvis/bin/jarvis-context
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=JARVIS_CONTEXT_GRPC_ADDR=127.0.0.1:50054
Environment=JARVIS_CONTEXT_HTTP_ADDR=127.0.0.1:8084
Environment=JARVIS_CONTEXT_PG_URL=postgres://jarvis:jarvis@localhost:5432/jarvis
Environment=JARVIS_CONTEXT_QDRANT_URL=http://127.0.0.1:6334
Environment=JARVIS_CONTEXT_COLLECTION_NAME=jarvis_memories
Environment=JARVIS_CONTEXT_PII_PATTERNS_PATH=/etc/jarvis/pii_patterns.toml
Environment=JARVIS_CONTEXT_MAX_CONTEXT_TOKENS=8000
Environment=JARVIS_CONTEXT_POLICY_GRPC_ADDR=http://127.0.0.1:50051
EnvironmentFile=-/run/jarvis/context.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-context

[Install]
WantedBy=multi-user.target