[Unit]
Description=JARVIS Context Builder
Documentation=https://github.com/Seduce0068/jarvis
# This binary embeds the shared migrations (001 and later, currently through
# 007) via `sqlx::migrate!()` and applies them at startup: it is the final,
# authoritative applier. jarvis-migrations.service is only the pre-flight
# oneshot that applies the same sources early for availability; from here it
# is just an ordering dependency. The existing policy ordering below is
# preserved (no cycle is introduced).
After=network.target postgresql.service qdrant.service jarvis-policy.service jarvis-migrations.service
Wants=postgresql.service qdrant.service jarvis-policy.service jarvis-migrations.service

[Service]
Type=exec
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env

# Secrets are resolved by bws run (Bitwarden Secrets Manager) at service start
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /opt/jarvis/bin/jarvis-context
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# I54-D: immediate stop — the builder does not drain in-flight handlers;
# spawned HTTP work is NOT guaranteed to finish. 10s is only a bounded
# teardown budget for bws signal forwarding and tracer flush, NOT a graceful
# drain window; reaching it means SIGKILL. The binary's shutdown log uses
# shutdown_policy=immediate-stop to match.
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=HOME=/opt/jarvis/data
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-context

[Install]
WantedBy=multi-user.target
