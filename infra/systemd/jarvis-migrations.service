[Unit]
Description=JARVIS shared DB migrations (sqlx)
Documentation=https://github.com/Seduce0068/jarvis
# Pre-flight applier for shared migrations (001 and later, through 005), not
# the authoritative owner: jarvis-context.service embeds the same
# migrations via `sqlx::migrate!()` and is the final applier (the migrations
# embedded in the context binary are authoritative). This oneshot applies them
# early so dependants start sooner; concurrent runs are serialized by the sqlx
# advisory lock. Migration sources and the context binary must ship from the
# same commit (see build-selfhost.sh): otherwise sqlx reports a checksum
# mismatch and jarvis-context fails to start.
# NOTE: adding a migration (e.g. 006) requires updating BOTH this "through NNN"
# range and the companion migration-distribution guard comment in
# infra/scripts/build-selfhost.sh in the SAME commit. build-selfhost.sh is
# outside this change's scope, so this note is the coordination point until
# that guard comment can carry the reminder itself.
# jarvis-policy.service and jarvis-context.service both declare After/Wants on
# this unit, so no policy <-> context ordering cycle is introduced. This unit
# itself only waits for the local PostgreSQL instance and the network.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Unprivileged service account: migrations never run as root.
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env
Environment=HOME=/opt/jarvis/data
Environment=RUST_LOG=info

# No credential value is stored in this unit. `bws run` injects the project
# secrets into the child process; sqlx is given an explicit --url, so map the
# injected variables inside a short-lived bash. The doubled `$$` is required:
# systemd would otherwise expand `${...}` at unit-parse time, before bws has
# injected anything. Migration sources come from the deployed Rust workspace
# at /opt/jarvis/rust/migrations.
#
# I99-B: apply the SAME shared migration set to both databases when both URLs
# are injected. jarvis-policy reads JARVIS_POLICY_PG_URL (config.rs `pg_url`,
# ENV_KEY) and calls PgApprovalPersistence::connect() at startup; the
# approval_requests / audit_log / kill_switch tables it needs come from
# 001_initial.sql. Applying only to JARVIS_CONTEXT_PG_URL left the policy DB
# without those tables when the two URLs drifted apart, producing a
# start-fail loop.
#
# Decision: keep both URL variables (do NOT unify to one shared variable).
# Unifying would require changing the policy binary's env key and its unit,
# both outside this change's scope, and would break installs where the two
# URLs intentionally point at different databases. This option is additive and
# backward compatible: pg_url is Option and require_approval_persistence
# defaults to false, so a blank/absent JARVIS_POLICY_PG_URL means policy uses
# the Noop store and the second run is skipped. When both URLs resolve to the
# same DB, the second `migrate run` is a no-op (checksum-recorded and
# advisory-lock serialized). JARVIS_CONTEXT_PG_URL stays mandatory, as before.
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /usr/bin/bash -c 'set -e; /usr/local/bin/cargo sqlx migrate run --source /opt/jarvis/rust/migrations --url "$${JARVIS_CONTEXT_PG_URL:?JARVIS_CONTEXT_PG_URL is required}"; if [[ -n "$${JARVIS_POLICY_PG_URL:-}" ]]; then /usr/local/bin/cargo sqlx migrate run --source /opt/jarvis/rust/migrations --url "$${JARVIS_POLICY_PG_URL}"; fi'
TimeoutStartSec=120

# Security hardening (same baseline as the other jarvis units).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=1G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-migrations

[Install]
WantedBy=multi-user.target
