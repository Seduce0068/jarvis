[Unit]
Description=JARVIS Event Normalizer
Documentation=https://github.com/Seduce0068/jarvis
# I99-B: opencode.service is appended to the existing dependency set. The
# runtime brings up its event/webhook consumer at startup; with parallel boot
# the first dispatch has no consumer and is lost. opencode orders only after
# policy/mcp-gw, never after event, so this adds no ordering cycle. All
# pre-existing After/Wants entries are retained.
After=network.target jarvis-policy.service jarvis-mcp-gw.service jarvis-context.service opencode.service
Wants=jarvis-policy.service jarvis-mcp-gw.service jarvis-context.service opencode.service

[Service]
Type=exec
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env

# Secrets are resolved by bws run (Bitwarden Secrets Manager) at service start
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /opt/jarvis/bin/jarvis-event
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# I54-D: immediate stop — the normalizer does not drain in-flight handlers;
# spawned webhook/HTTP work is NOT guaranteed to finish. 10s is only a bounded
# teardown budget for bws signal forwarding and tracer flush, NOT a graceful
# drain window; reaching it means SIGKILL. The binary's shutdown log uses
# shutdown_policy=immediate-stop to match.
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=HOME=/opt/jarvis/data
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Resource limits
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-event

[Install]
WantedBy=multi-user.target
