[Unit]
Description=JARVIS MCP Gateway
Documentation=https://github.com/Seduce0068/jarvis
After=network.target jarvis-policy.service
Wants=jarvis-policy.service

[Service]
Type=exec
User=koppe
Group=koppe
WorkingDirectory=/opt/jarvis/rust
EnvironmentFile=-/etc/jarvis/bws.env
# Host-specific overrides (incl. JARVIS_MCP_GW_BASE_DIR) are supplied here at
# deploy time. Optional ("-") so the unit stays valid before provisioning.
EnvironmentFile=-/etc/jarvis/jarvis-mcp-gw.env

# Secrets are injected by Bitwarden Secrets Manager (bws) at service start
ExecStart=/usr/local/bin/bws run --project-id 6108d695-14ce-42ec-aded-b4f50084d403 -- /opt/jarvis/bin/jarvis-mcp-gw
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Read-only tools (filesystem.*, git.*) read the user's home. ProtectHome=yes
# masks /home entirely, which made every native handler fail with EACCES on
# canonicalize. Keep the home mount visible but read-only.
ProtectHome=read-only
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis /tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=HOME=/opt/jarvis/data
Environment=RUST_LOG=info
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Workspace root for the native read-only handlers. Must stay readable under
# ProtectHome=read-only; the value is also the path-escape boundary.
# systemd.exec(5) performs NO variable expansion inside Environment= (the "$"
# has no special meaning there): ${VAR:-default} would be passed as a literal
# string. The value below is therefore a LITERAL default only.
# The ONLY override path is the existing
# EnvironmentFile=-/etc/jarvis/jarvis-mcp-gw.env above; values read from an
# EnvironmentFile= take precedence over Environment= values.
Environment=JARVIS_MCP_GW_BASE_DIR=/home/koppe/ドキュメント/作業用/jarvis/jarvis
# web.fetch egress allowlist (comma-separated host patterns). Empty/invalid
# means deny-all (fail-closed). This is a LITERAL default (no ${...} expansion
# in Environment=; see systemd.exec(5)). The ONLY override path is the
# EnvironmentFile=-/etc/jarvis/jarvis-mcp-gw.env above, whose values take
# precedence over Environment=; set the minimum host set the deployment needs.
Environment=JARVIS_MCP_GW_EGRESS_ALLOWLIST=example.com

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=150%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-mcp-gw

[Install]
WantedBy=multi-user.target
