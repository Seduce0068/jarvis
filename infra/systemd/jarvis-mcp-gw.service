[Unit]
Description=JARVIS MCP Gateway
Documentation=https://github.com/koppe/jarvis
After=network.target jarvis-policy.service
Wants=jarvis-policy.service

[Service]
Type=notify
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/rust
ExecStartPre=/usr/local/bin/op inject -i /etc/jarvis/mcp_gateway.env -o /run/jarvis/mcp_gateway.env
ExecStart=/opt/jarvis/bin/jarvis-mcp-gw
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs /etc/jarvis /tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=RUST_LOG=info
Environment=JARVIS_MCP_GW_GRPC_ADDR=127.0.0.1:50052
Environment=JARVIS_MCP_GW_HTTP_ADDR=127.0.0.1:8082
Environment=JARVIS_MCP_GW_ALLOWLIST_PATH=/etc/jarvis/mcp_allowlist.toml
Environment=JARVIS_MCP_GW_SANDBOX_TYPE=firejail
Environment=JARVIS_MCP_GW_POLICY_GRPC_ADDR=http://127.0.0.1:50051
EnvironmentFile=-/run/jarvis/mcp_gateway.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=150%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-mcp-gw

[Install]
WantedBy=multi-user.target