[Unit]
Description=JARVIS Backup Job
Documentation=https://github.com/koppe/jarvis
After=network.target

[Service]
Type=oneshot
User=jarvis
Group=jarvis
ExecStart=/usr/local/bin/rust-script /opt/jarvis/scripts/backup.rs
WorkingDirectory=/opt/jarvis/scripts

# Security
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jarvis/.cache/rust-script /opt/jarvis/backups /opt/jarvis/data /opt/jarvis/logs /etc/jarvis /run/rclone

# Environment for 1Password
Environment=OP_SESSION_FILE=/home/jarvis/.config/op/session
Environment=HOME=/home/jarvis

# Resource limits
MemoryMax=1G
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-backup
