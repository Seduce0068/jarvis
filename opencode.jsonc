{
  "model": "opencode/longcat-2.5-preview-free",
  // The JARVIS gateway is served by jarvis-mcp-gw as MCP Streamable HTTP.
  // On the JARVIS host it is wired by infra/config/opencode/opencode.jsonc;
  // in this repository it connects only when the gateway runs on 127.0.0.1:8082.
  "mcp": {
    "servers": {
      "jarvis-gateway": {
        "type": "remote",
        "url": "http://127.0.0.1:8082/mcp",
        "oauth": false
      }
    }
  },
  // Schema note: the enforced field is `permission` (singular); `permissions`
  // (plural) is informational (OpenCodeRust docs/opencode-config.md:37-46).
  // Pattern matching is substring based ("*<text>*"); wildcard rules sort
  // first and longer patterns later, so the most specific match wins
  // (ruleset.rs:123-142, agent.rs:811-824, 1132-1168). For bash the target is
  // the command string, for read/edit/glob/grep/list it is the file path.
  // Keep dev work flowing with "*": "allow" plus targeted secret denials.
  "permission": {
    "read": {
      "*.env*": "deny",
      "*.env.example*": "allow",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*id_rsa*": "deny",
      "*.kdbx*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.kube/*": "deny",
      "*.config/gcloud/*": "deny",
      "*.npmrc*": "deny"
    },
    "edit": {
      "*.env*": "deny",
      "*.env.example*": "allow",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*id_rsa*": "deny",
      "*.kdbx*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.kube/*": "deny",
      "*.config/gcloud/*": "deny",
      "*.npmrc*": "deny"
    },
    // bash: command-string deny prevents the shell from bypassing read/edit.
    // No .env.example exception: one command can mention a template and a real
    // .env, and the longer allow pattern would win for the whole command.
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*id_rsa*": "deny",
      "*.kdbx*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.kube/*": "deny",
      "*.config/gcloud/*": "deny",
      "*.npmrc*": "deny"
    },
    // task matches subagent_type, not a path: effective containment lives in
    // the per-agent `permission` blocks below.
    "task": {
      "*": "allow",
      "*.env*": "deny",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.config/gcloud/*": "deny"
    },
    "glob": {
      "*": "allow",
      "*.env*": "deny",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.config/gcloud/*": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env*": "deny",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.config/gcloud/*": "deny"
    },
    "list": {
      "*": "allow",
      "*.env*": "deny",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.config/gcloud/*": "deny"
    },
    "patch": {
      "*": "allow",
      "*.env*": "deny",
      "*.env.example*": "allow",
      "*bws.env*": "deny",
      "*.key*": "deny",
      "*.pem*": "deny",
      "*secrets/*": "deny",
      "*.ssh/*": "deny",
      "*.aws/*": "deny",
      "*.config/gcloud/*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "agents": {
    "jarvis-dev": {
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "description": "jarvis専用実装エージェント",
      "system": "You are a JARVIS implementation specialist. Implement Rust services for the JARVIS Personal AI system. Follow the architecture in adr/0001-unified-architecture.md. Write idiomatic Rust, run tests, and never deploy or access credentials directly.",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ],
      // The local runtime enforces the singular `permission` field; keep the
      // dev allows and deny secret material for delegated execution too.
      "permission": {
        "bash": {
          "*": "allow",
          "*.env*": "deny",
          "*bws.env*": "deny",
          "*.key*": "deny",
          "*.pem*": "deny",
          "*secrets/*": "deny",
          "*.ssh/*": "deny",
          "*.aws/*": "deny",
          "*.config/gcloud/*": "deny"
        },
        "read": {
          "*.env*": "deny",
          "*.env.example*": "allow",
          "*bws.env*": "deny",
          "*.key*": "deny",
          "*.pem*": "deny",
          "*secrets/*": "deny",
          "*.ssh/*": "deny",
          "*.aws/*": "deny",
          "*.config/gcloud/*": "deny"
        },
        "edit": {
          "*.env*": "deny",
          "*.env.example*": "allow",
          "*bws.env*": "deny",
          "*.key*": "deny",
          "*.pem*": "deny",
          "*secrets/*": "deny",
          "*.ssh/*": "deny",
          "*.aws/*": "deny",
          "*.config/gcloud/*": "deny"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "jarvis-policy-audit": {
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "description": "Policy audit specialist for Cedar/Casbin policies",
      "system": "You are a policy auditor. Review Cedar/Casbin policies for correctness, completeness, and security. Check for over-permissive rules, missing deny rules, and kill switch coverage. Do not modify policies - only audit and report findings with file:line references.",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ],
      // Enforced form of the read-only intent above for the local runtime.
      "permission": {
        "bash": { "*": "deny" },
        "edit": { "*": "deny" },
        "read": {
          "*.env*": "deny",
          "*bws.env*": "deny",
          "*.key*": "deny",
          "*.pem*": "deny",
          "*secrets/*": "deny",
          "*.ssh/*": "deny",
          "*.aws/*": "deny",
          "*.config/gcloud/*": "deny"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
